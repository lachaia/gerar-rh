# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# valores reais do seu ambiente. O ".env" nunca deve ser versionado.

# Banco de dados
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# IA - extração de currículo (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini (configurado como alternativa, não está em uso atualmente)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# E-mail transacional (Amazon SES)
SES_HOST=email-smtp.sa-east-1.amazonaws.com
SES_USERNAME=
SES_PASSWORD=
SES_PORT=587
MAIL_FROM_ADDRESS=rh@gerar.org.br
MAIL_FROM_NAME=RH-Gerar

# Google Calendar (conta de serviço, domain-wide delegation)
# Caminho absoluto para o arquivo JSON da conta de serviço (não versionado)
GOOGLE_CALENDAR_CREDENTIALS=

# Segredo para assinar URLs temporárias de documentos (preview no Google Docs Viewer)
# Gere com: php -r "echo bin2hex(random_bytes(32));"
DOCS_TOKEN_SECRET=

# Chave AES para criptografar dados sensíveis de denúncias/ouvidoria.
# ATENÇÃO: se já existem registros gravados, use o valor atual — trocar a
# chave torna esses registros antigos permanentemente ilegíveis.
OUVIDORIA_CRYPTO_KEY=
