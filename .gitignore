# ============================================================
# Dependências (não versionar, reinstalar via composer/npm)
# ============================================================
app/vendor
/vendor/
/node_modules/
.env

# ============================================================
# Credenciais e segredos — NUNCA versionar
# (o código lê de variáveis de ambiente; só o .env real e os
# arquivos de chave abaixo contêm valor secreto de verdade)
# ============================================================
app/credentials.json
app/chaves/

# ============================================================
# Dados reais de colaboradores/candidatos (PII) — nunca versionar
# (o .htaccess de cada pasta é a exceção: precisa ir para o git,
# é ele que bloqueia execução de PHP dentro da pasta de upload)
# ============================================================
app/docs/*
!app/docs/.htaccess
app/temp/*
!app/temp/.htaccess
app/includes/uploads/*
!app/includes/uploads/.htaccess
app/ponto/uploads/*
!app/ponto/uploads/.htaccess
recrutamento/docs/*
!recrutamento/docs/.htaccess
usu_*.png
usu_*.jpg
usu_*.jpeg
usu_*.webp

# ============================================================
# Logs e arquivos de debug
# ============================================================
*.log
app/buffer.txt
app/buffer/
