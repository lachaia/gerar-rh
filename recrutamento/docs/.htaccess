# Pasta de documentos enviados por usuários — nunca deve executar scripts.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php[3-8]?|phtml|phar|cgi|pl|py|sh|asp|aspx|exe)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php[3-8]?|phtml|phar|cgi|pl|py|sh|asp|aspx|exe)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
