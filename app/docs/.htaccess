# Pasta de documentos de colaboradores/candidatos — nunca deve executar
# scripts, e o acesso direto ao arquivo estático fica bloqueado: tudo passa
# por app/docs_view.php, que valida sessão/posse antes de entregar o arquivo.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
